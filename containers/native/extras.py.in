#!/usr/bin/env python3
"""Build missing ISO dependencies inside Docker, retaining provenance receipts."""
import argparse
import hashlib
import json
import os
import re
import shlex
from pathlib import Path
import shutil
import subprocess
import tempfile
import sys
sys.path.insert(0,'/src')

ROOT = Path('/opt/stream')
OUT = Path('/debs')
WORK = Path('/extra')
JOOL_SOURCE = 'jool-4.1.9+bf4c7e3669/Jool-7f08c42c615ed63cf0fdc1522d91aa0809f6d990'


def jool_version():
    text=(Path('/sources')/JOOL_SOURCE/'configure.ac').read_text()
    match=re.search(r'AC_INIT\(\[Jool\],\s*\[([^]]+)\]',text)
    if not match or match[1]!='4.1.11':
        raise ValueError('Unexpected Jool source version in signed snapshot')
    return match[1]+'+stream202603-1'




def shell_environment():
    from producer.resources import environment
    env=environment();env.update(DEBIAN_FRONTEND='noninteractive',PATH='/opt/go/bin:'+os.environ['PATH'])
    return env


def shell(script, cwd=None):
    from producer.resources import profile
    budget=profile();jobs=str(budget['compile_jobs'])
    script=script.replace('make -j2','make -j'+jobs)
    env=shell_environment()
    subprocess.run(['bash','-euo','pipefail','-c',script],cwd=cwd,check=True,env=env)


def snapshot(path, target):
    shutil.copytree(Path('/sources') / path, target, symlinks=True)
    return target


def git(name, target):
    lock = json.loads((ROOT / 'external-sources.lock.json').read_text())[name]
    target.mkdir()
    shell('git init -q; git remote add origin '+lock['url']+'; git fetch --depth=80 origin '+lock['commit']+'; git checkout --detach FETCH_HEAD', target)
    actual = subprocess.check_output(['git','rev-parse','HEAD'],cwd=target,text=True).strip()
    if actual != lock['commit']:
        raise ValueError('External Git source mismatch')
    if lock.get('tag'):
        shell('git fetch --depth=1 origin tag '+lock['tag'], target)
    return target


def copy_debs(root, pattern='**/*.deb'):
    packages = list(root.glob(pattern))
    found = 0
    for path in packages:
        if not path.is_file():
            continue
        if '-build-deps_' in path.name:
            continue
        architecture = subprocess.check_output(['dpkg-deb','-f',str(path),'Architecture'],text=True).strip()
        if architecture not in ['@ARCH@','all']:
            raise ValueError('Unexpected architecture: '+str(path))
        target = OUT / path.name
        if target.exists() and target.read_bytes() != path.read_bytes():
            raise ValueError('Conflicting package: '+path.name)
        shutil.copy2(path,target)
        found += 1
    if not found:
        raise ValueError('No packages produced in '+str(root))


def debian(source, unprivileged=False):
    prepare="eval $(opam env --root=/opt/opam --set-root); dpkg-source --before-build .; mk-build-deps --install --remove --tool 'apt-get -y --no-install-recommends' debian/control; "
    if unprivileged:
        # Standard non-root dpkg-buildpackage/fakeroot preserves root package
        # ownership while allowing upstream daemons to enforce their root guard.
        shell(prepare+'true',source)
        subprocess.run(['chown','nobody:nogroup',str(source.parent)],check=True)
        subprocess.run(['chown','-R','nobody:nogroup',str(source)],check=True)
        shell('runuser -u nobody -- dpkg-buildpackage -b -us -uc',source)
    else:
        shell(prepare+'dpkg-buildpackage -b -us -uc',source)


def install_dependencies():
    shell('apt-get update; apt-get install -y --no-install-recommends cmake libssl-dev liblua5.3-dev libpcre3-dev libnl-genl-3-dev libsnmp-dev libxtables-dev libcap-dev libunwind-dev llvm kmod dh-python python3-stdeb python3-dev')




def vpp(work):
    source = git('vpp',work/'vpp')
    patches = git('vpp-patches',work/'patches')
    for patch in sorted((patches/'patches/vpp').glob('*.patch')):
        subprocess.run(['git','-c','user.name=michibiki-io source preparation','-c','user.email=maintainers@michibiki.io','am',str(patch)],
            cwd=source,env=dict(os.environ,GIT_COMMITTER_DATE='2026-03-18T00:00:00Z'),check=True)
    from producer.vpp_inputs import prepare,prepare_external
    prepare(json.loads(Path('/src/native/vpp-python.lock.json').read_text()),source/'build/external/downloads',Path('/public-inputs/vpp-python'))
    prepare_external(json.loads(Path('/src/native/vpp-external.lock.json').read_text()),source/'build/external/downloads',Path('/public-inputs/vpp-external'))
    # Upstream skips its unpinned pip download when the fixed Meson archive is
    # already present. Disable index access as well: missing inputs must fail.
    # CMake also invokes pip in an isolated PEP 517 environment for vpp-papi.
    # That environment must resolve setuptools from these same fixed wheels.
    wheelhouse=source/'build/external/downloads'
    shell('export PIP_NO_INDEX=1 PIP_NO_CACHE_DIR=1 PIP_FIND_LINKS='+shlex.quote(str(wheelhouse))+'; make UNATTENDED=yes VPP_ENABLE_SYSTEMD_NOTIFY=ON install-dep; make MAKE_PARALLEL_JOBS="$MAKE_PARALLEL_JOBS" VPP_EXTRA_CMAKE_ARGS="-DVPP_ENABLE_SYSTEMD_NOTIFY=ON" pkg-deb',source)
    copy_debs(source/'build-root')


def base(work):
    # The snapshot predates the vendor's package rename; preserve the real PAM
    # implementation and change only its Debian identity to the required name.
    pam=snapshot('libpam-radius-auth_1.5.0-cl3u7/libpam-radius-auth',work/'pam')
    for path in (pam/'debian').iterdir():
        if path.is_file():
            try: text=path.read_text()
            except UnicodeError: continue
            path.write_text(text.replace('libpam-radius-auth','vyos-libpam-radius-auth'))
        if path.name.startswith('libpam-radius-auth.'):
            path.rename(path.with_name(path.name.replace('libpam-radius-auth.','vyos-libpam-radius-auth.',1)))
    debian(pam)
    # Preserve the already verified unchanged helper packages; only the PAM
    # namespace changes in this rebuild.
    for package in work.glob('radius-shell*.deb'): package.unlink()
    utils=git('vyos-utils',work/'utils'); debian(utils)
    humps=snapshot('humps_v3.8.0/humps',work/'humps')
    shell('apt-get install -y --no-install-recommends python3-pytest; python3 setup.py --command-packages=stdeb.command bdist_deb',humps)
    ddclient=snapshot('ddclient_debian_3.11.2-1/ddclient',work/'ddclient'); debian(ddclient)
    i2util=git('i2util',work/'i2util'); debian(i2util)
    development=list(work.glob('libi2util-dev_*_@ARCH@.deb'))
    if len(development)!=1:raise ValueError('Exactly one source-built I2util development package required')
    # OWAMP's loose >=1.4 dependency otherwise selects Debian's older 1.6
    # library, rather than the exact public source recipe just built above.
    shell('apt-get install -y --no-install-recommends '+str(development[0]))
    owamp=snapshot('owamp_v4.4.6/owamp',work/'owamp'); debian(owamp,unprivileged=True)
    otp=snapshot('openvpn-otp_9781ff1/openvpn-otp',work/'otp')
    shell('apt-get install -y --no-install-recommends openvpn; ./autogen.sh; ./configure --prefix=/usr; make -j2; mkdir -p package/usr/lib/openvpn; cp src/.libs/openvpn-otp.so package/usr/lib/openvpn/; python3 /src/native/fpm_package.py -s dir -t deb -n openvpn-otp -v 9781ff1 --depends openvpn --architecture @ARCH@ -C package --package ..',otp)
    relay=snapshot('udp-broadcast-relay_9a0f13b4b5938bfe0af0d0d4e99dfc127c068e28/udp-broadcast-relay',work/'relay')
    for patch in sorted(Path('/sources/vyos-build/vyos-build/scripts/package-build/udp-broadcast-relay/patches').glob('**/*.patch')):
        shell('patch --fuzz=0 -p1 < '+str(patch),relay)
    debian(relay)
    copy_debs(work)


def go_packages(work):
    from producer.go_modules import prepare_dependencies
    jobs=[('node_exporter_v1.9.1/node_exporter','node_exporter','node-exporter','1.9.1'),
          ('frr_exporter_v1.5.0/frr_exporter','frr_exporter','frr-exporter','1.5.0'),
          ('blackbox_exporter_v0.26.0/blackbox_exporter','blackbox_exporter','blackbox-exporter','0.26.0')]
    for path,binary,name,version in jobs:
        source=snapshot(path,work/name)
        # The optional btrfs collector links ioctl v1.0.0, whose exact source
        # ZIP has no permission notice. Use upstream's supported exclusion on
        # both architectures; do not waive the unresolved dependency license.
        tags='-tags nobtrfs' if name=='node-exporter' else ''
        prepare_dependencies(['/opt/go/bin/go','list','-deps',*shlex.split(tags),'.'],
                             cwd=source,env=shell_environment())
        shell(f'go build {tags} -ldflags "-X github.com/prometheus/common/version.Version={version}" -o {binary}',source)
        actual=subprocess.check_output([str(source/binary),'--version'],stderr=subprocess.STDOUT,text=True)
        if not re.search(r'(?<![0-9])'+re.escape(version)+r'(?![0-9])',actual):
            raise ValueError('Source-built exporter version mismatch')
        if name=='node-exporter':
            info=subprocess.check_output(['/opt/go/bin/go','version','-m',str(source/binary)],text=True)
            if '\tdep\tgithub.com/dennwc/ioctl\t' in info:
                raise ValueError('Unresolved optional ioctl dependency remains linked')
        (source/'SHIRUBE-BUILD.json').write_text(json.dumps({'version':version,'build_tags':['nobtrfs'] if tags else [],
            'compiler_version':json.loads(Path('/src/source-lock.json').read_text())['go']['version']},indent=2)+'\n')
        shell(f'mkdir -p package/usr/sbin; cp {binary} package/usr/sbin/; python3 /src/native/fpm_package.py -s dir -t deb -n {name} -v {version} --architecture @ARCH@ -C package --package ..',source)
    source=snapshot('telegraf_v1.28.3/telegraf',work/'telegraf')
    from producer.go_modules import module_hash,escape
    from producer.sources import sha256
    lock=json.loads(Path('/src/source-lock.json').read_text())
    for module,record in lock['go_dependency_overrides']['telegraf'].items():
        version=record['version']
        subprocess.run(['/opt/go/bin/go','mod','edit','-require='+module+'@'+version],cwd=source,check=True)
        result=json.loads(prepare_dependencies(['/opt/go/bin/go','mod','download','-json',module+'@'+version],cwd=source))
        archive=Path(result['Zip'])
        if sha256(archive)!=record['sha256'] or module_hash(archive,module,version)!=record['h1']:
            raise ValueError('Fixed licensed Go dependency source differs')
    prepare_dependencies(['/opt/go/bin/go','list','-deps','./cmd/telegraf'],
                         cwd=source,env=shell_environment())
    shell('go build -ldflags "-X github.com/influxdata/telegraf/internal.Version=1.28.3" -o telegraf ./cmd/telegraf',source)
    actual=subprocess.check_output([str(source/'telegraf'),'--version'],stderr=subprocess.STDOUT,text=True)
    if not re.search(r'(?<![0-9])1\.28\.3(?![0-9])',actual):raise ValueError('Source-built Telegraf version mismatch')
    shell('mkdir -p package/usr/bin; cp telegraf package/usr/bin/; python3 /src/native/fpm_package.py -s dir -t deb -n telegraf -v 1.28.3-1 --architecture @ARCH@ -C package --package ..',source)
    copy_debs(work)


def kea(work):
    source=snapshot('isc-kea_Kea-3.0.2/isc-kea',work/'isc-kea')
    packaging=git('kea-packaging',work/'packaging')
    if (source/'debian').exists(): shutil.rmtree(source/'debian')
    shutil.copytree(packaging/'debian',source/'debian')
    shell(r'''sed -i 's/{VERSION}/3.0.2/g; s/{ISC_VERSION}/vyos/g' debian/changelog
sed -i 's/{ISC_VERSION}/vyos/g; /meson compile -C build doc/d' debian/rules
sed -Ei '/^Package: isc-kea-(premium|subscriber)/,/^$/d' debian/control
sed -i '/usr\/share\/man/d; /usr\/share\/doc\/kea/d' debian/*.install
printf 'usr/share/doc/kea/*\nusr/share/kea/meson-info/*\n' >> debian/not-installed
rm -f debian/isc-kea-doc.install debian/isc-kea-subscriber* debian/isc-kea-premium*
''',source)
    rules=source/'debian/rules'
    text=rules.read_text()
    if 'meson compile -C build' not in text: raise ValueError('Unexpected Kea compile rule')
    from producer.resources import profile
    parallel=str(profile()['compile_jobs'])
    rules.write_text(text.replace('meson compile -C build','meson compile -C build -j '+parallel).replace('meson test -C build','meson test -C build --num-processes '+parallel))
    # The pinned packaging omits Meson from Build-Depends. Keep Kea's
    # newer tool separate from VPP's upstream-pinned Meson bootstrap.
    from producer.sources import download,sha256,extract
    tool=json.loads(Path('/src/source-lock.json').read_text())['kea_build_tool']
    inputs=source/'shirube-corresponding-inputs';inputs.mkdir()
    archive=inputs/('meson-'+tool['version']+'.tar.gz')
    download(tool['url'],archive)
    if sha256(archive)!=tool['sha256']:raise ValueError('Kea Meson source checksum mismatch')
    extract(archive,work/'build-tools')
    meson=work/'build-tools'/('meson-'+tool['version'])/'meson.py'
    if not meson.is_file():raise ValueError('Kea Meson entry point missing')
    rules.write_text(rules.read_text().replace('meson ', 'python3 '+str(meson)+' '))
    shell('apt-get install -y --no-install-recommends ninja-build',source)
    debian(source)
    copy_debs(work)


def salt(work):
    source=snapshot('salt_v3006.21/salt',work/'salt')
    shell("git init -q; git add .; GIT_AUTHOR_DATE=2026-03-18T00:00:00Z GIT_COMMITTER_DATE=2026-03-18T00:00:00Z git -c user.name='Stream snapshot' -c user.email=maintainers@vyos.net commit -qm 'Verified source snapshot'; git tag v3006.21",source)
    git('salt-tools',source/'python-tools-scripts')
    from producer.salt_sources import pin_build
    pin_build(source,'@ARCH@',Path('/src/native/salt-sources.lock.json'))
    from producer.salt_cargo import prepare as prepare_cargo, patch_sdk_environment
    cargo_home=prepare_cargo(Path('/src/native/salt-sources.lock.json'),work/'cargo-inputs',
                             Path('/public-inputs/salt-cargo'))
    from producer.salt_python import prepare as prepare_python
    python_inputs=prepare_python(Path('/src/native/salt-sources.lock.json'),'@ARCH@',
                                 work/'python-inputs',Path('/public-inputs/salt-python'))
    patch_sdk_environment(source,cargo_home,python_inputs)
    runtime_arch='x86_64' if '@ARCH@'=='amd64' else 'arm64'
    shell(r'''apt-get install -y --no-install-recommends libssl-dev libffi-dev python3-dev python3-pip python3-venv patchelf fakeroot dpkg-dev cargo dh-make libgdbm-dev liblzma-dev libzmq3-dev pkg-config bash-completion
python3 -m venv venv-build
venv-build/bin/python3 -m pip install pip==25.2
venv-build/bin/python3 -m pip install -r requirements/static/ci/py3.11/tools.txt ./python-tools-scripts relenv==0.22.3 build==1.3.0 msgpack-python==0.5.6 ppbt==0.1.8 setuptools==66.1.1 tornado==6.6
export PYTHONPATH=$PWD
venv-build/bin/tools pkg build deb --relenv-version=0.22.3 --python-version=3.11.14 --arch=@SALT_ARCH@
'''.replace('@SALT_ARCH@',runtime_arch),source)
    copy_debs(work)


def podman(work):
    source=snapshot('podman_v4.9.5/podman',work/'podman')
    shell(r'''apt-get install -y --no-install-recommends libseccomp-dev libgpgme-dev libapparmor-dev libsystemd-dev libsubid-dev go-md2man
# The release target only needs the snapshot's packaged manual generator;
# install.tools also downloads unrelated test/lint executables.
make -j1 podman-release RELEASE_NUMBER=4.9.5 GOMD2MAN=/usr/bin/go-md2man GIT_COMMIT= PREFIX=/usr RELEASE_PREFIX=/usr SOURCE_DATE_EPOCH=1773859634
archive=podman-release-@ARCH@.tar.gz
tar -xf "$archive"
python3 /src/native/fpm_package.py -s dir -t deb -n podman -v 4.9.5 --architecture @ARCH@ --depends conmon --depends crun --depends netavark --depends libgpgme11 --depends fuse-overlayfs --depends golang-github-containers-common -C podman-v4.9.5 --package ..
''',source)
    copy_debs(work)


def headers():
    # Kernel headers are the exact native package built in the kernel stage.
    packages=list(OUT.glob('linux-headers-6.6.128-vyos_*_@ARCH@.deb'))
    if len(packages)!=1: raise ValueError('Exactly one matching kernel headers package is required')
    path=Path('/usr/src/linux-headers-6.6.128-vyos')
    identity=hashlib.sha256(packages[0].read_bytes()).hexdigest()
    marker=path/'.source-deb-sha256'
    if marker.is_file() and marker.read_text()==identity: return path
    # Extract only usr/src into its final location. Extracting the entire legacy
    # archive onto / replaces Debian's merged-/usr /lib symlink with a directory.
    with tempfile.TemporaryDirectory() as temporary:
        subprocess.run(['dpkg-deb','-x',str(packages[0]),temporary],check=True)
        staged=Path(temporary)/'usr/src/linux-headers-6.6.128-vyos'
        if not staged.is_dir(): raise ValueError('Kernel headers path missing')
        if path.exists(): shutil.rmtree(path)
        shutil.copytree(staged,path,symlinks=True)
    marker.write_text(identity)
    return path


def modules(work):
    kernel=headers()
    common=Path('/sources/vyos-build/vyos-build/scripts/package-build/linux-kernel')
    ovpn=snapshot('ovpn-dco-v0.2.20231117/ovpn-dco',work/'ovpn')
    from producer.embedded_notices import retain as retain_embedded_notices
    retain_embedded_notices(ovpn,'openvpn-dco',Path('/src/source-lock.json'))
    shell(f'''make KERNEL_SRC={kernel} clean
make -j2 KERNEL_SRC={kernel}
mkdir -p package/lib/modules/6.6.128-vyos/extra
cp drivers/net/ovpn-dco/ovpn-dco-v2.ko package/lib/modules/6.6.128-vyos/extra/
python3 /opt/stream/sign-modules.py package
python3 /src/native/fpm_package.py -s dir -t deb -n openvpn-dco -v 0.2.20231117 --architecture @ARCH@ --depends linux-image-6.6.128-vyos -C package --package ..''',ovpn)
    rtsp=git('nat-rtsp',work/'rtsp')
    retain_embedded_notices(rtsp,'nat-rtsp',Path('/src/source-lock.json'))
    shell(f'''make KERNELDIR={kernel} clean
make -j2 KERNELDIR={kernel}
mkdir -p package/lib/modules/6.6.128-vyos/extra
cp nf_conntrack_rtsp.ko nf_nat_rtsp.ko package/lib/modules/6.6.128-vyos/extra/
python3 /opt/stream/sign-modules.py package
python3 /src/native/fpm_package.py -s dir -t deb -n nat-rtsp -v 5.3-2-g475af0a --architecture @ARCH@ --depends linux-image-6.6.128-vyos -C package --package ..''',rtsp)
    netflow=git('ipt-netflow',work/'netflow')
    for patch in sorted((common/'patches/ipt-netflow').glob('*.patch')):
        shell('patch --fuzz=0 -p1 < '+str(patch),netflow)
    retain_embedded_notices(netflow,'vyos-ipt-netflow',Path('/src/source-lock.json'))
    shell(f'''./configure --enable-direction --enable-macaddress --enable-vlan --enable-sampler --enable-aggregation --kdir={kernel}
make clean
make -j2 all
mkdir -p package/lib/modules/6.6.128-vyos/extra package/lib/@MULTIARCH@/xtables
cp ipt_NETFLOW.ko package/lib/modules/6.6.128-vyos/extra/
cp libipt_NETFLOW.so libip6t_NETFLOW.so package/lib/@MULTIARCH@/xtables/
python3 /opt/stream/sign-modules.py package
python3 /src/native/fpm_package.py -s dir -t deb -n vyos-ipt-netflow -v 2.6-67-g6135551 --architecture @ARCH@ --depends linux-image-6.6.128-vyos -C package --package ..''',netflow)
    jool=snapshot(JOOL_SOURCE,work/'jool')
    shell(f'''apt-get install -y --no-install-recommends libnl-genl-3-dev
./autogen.sh
./configure --prefix=/usr
make KERNEL_DIR={kernel} clean
make -j2
make -C {kernel} M=$PWD/src/mod/common modules
make -C {kernel} M=$PWD/src/mod/nat64 modules
make -C {kernel} M=$PWD/src/mod/siit modules
make DESTDIR=$PWD/package install
mkdir -p package/lib/modules/6.6.128-vyos/extra
cp src/mod/common/jool_common.ko src/mod/nat64/jool.ko src/mod/siit/jool_siit.ko package/lib/modules/6.6.128-vyos/extra/
python3 /opt/stream/sign-modules.py package
python3 /src/native/fpm_package.py -s dir -t deb -n jool -v {jool_version()} --architecture @ARCH@ --depends linux-image-6.6.128-vyos --depends libnl-3-200 --depends libnl-genl-3-200 -C package --package ..''',jool)
    copy_debs(work)


def accel(work):
    kernel=headers()
    if not Path('/vpp-sdk').exists():
        from producer.native_stages import export_vpp_sdk
        export_vpp_sdk(Path('/extra/vpp/vpp'),Path('/vpp-sdk'),'@MULTIARCH@','@ARCH@')
    # VPP's runtime postinst changes sysctls. Compilation needs only its SDK
    # and libraries, so never execute that runtime setup in a build sandbox.
    sdk=work/'vpp-sdk'
    sdk.mkdir()
    for pattern in ['libvppinfra_*.deb','libvppinfra-dev_*.deb','vpp_*.deb','vpp-dev_*.deb']:
        packages=list(OUT.glob(pattern))
        if len(packages)!=1: raise ValueError('Exactly one VPP SDK package required: '+pattern)
        subprocess.run(['dpkg-deb','-x',str(packages[0]),str(sdk)],check=True)
    for directory in ['include','lib']:
        shutil.copytree(sdk/'usr'/directory,Path('/usr')/directory,dirs_exist_ok=True,symlinks=True)
    shell('ldconfig')
    source=snapshot('accel-ppp-ng-3e30d9b/accel-ppp-ng',work/'accel')
    common=Path('/sources/vyos-build/vyos-build/scripts/package-build/linux-kernel')
    for patch in sorted((common/'patches/accel-ppp-ng').glob('*.patch')):
        shell('patch --fuzz=0 -p1 < '+str(patch),source)
    if (source/'build').exists(): shutil.rmtree(source/'build')
    (source/'build').mkdir()
    shell(f'cmake -DBUILD_IPOE_DRIVER=TRUE -DBUILD_VLAN_MON_DRIVER=TRUE -DCMAKE_INSTALL_PREFIX=/usr -DKDIR={kernel} -DLUA=5.3 -DMODULES_KDIR=6.6.128-vyos -DHAVE_VPP=1 -DHAVE_SESSION_HOOKS=1 -DCPACK_TYPE=Debian12 ..; CPATH=/usr/include/vpp-api:/vpp-sdk/source/vpp-api:/vpp-sdk/source:/vpp-sdk/generated LIBRARY_PATH=/vpp-sdk/lib make -j2; python3 /opt/stream/sign-modules.py .; cpack -G DEB',source/'build')
    copy_debs(work)
    sflow=snapshot('host-sflow_v2.1.21-1/host-sflow',work/'sflow')
    from producer.sflow import prepare as prepare_sflow
    prepare_sflow(sflow)
    shell('apt-get install -y --no-install-recommends libpcap0.8-dev libdbus-1-dev clang; make clean; make -j2 deb FEATURES="PCAP DROPMON DBUS PSAMPLE VPP"',sflow)
    copy_debs(sflow,'hsflowd_*_@ARCH@.deb')


def main():
    parser=argparse.ArgumentParser(description=__doc__)
    parser.add_argument('job',choices=['vpp','base','go','kea','salt','podman','modules','accel'])
    args=parser.parse_args()
    WORK.mkdir(exist_ok=True)
    OUT.mkdir(exist_ok=True)
    work=WORK/args.job
    work.mkdir()
    if args.job=='go': go_packages(work)
    else: globals()[args.job](work)
    hashes={p.name:hashlib.sha256(p.read_bytes()).hexdigest() for p in sorted(OUT.glob('*.deb'))}
    (OUT/f'{args.job}.json').write_text(json.dumps({'status':'PASS','artifacts':hashes},indent=2)+'\n')


if __name__=='__main__': main()
