#!/usr/bin/env python3
"""Sign out-of-tree modules with this build's kernel key, never exporting it."""
import argparse
import gzip
import hashlib
import io
import lzma
from pathlib import Path
import subprocess
import tarfile
import tempfile

MAGIC=b'~Module signature appended~\n'
KEYDIR=Path('/kernel-signing')


def verify(data, certificate):
    if not data.endswith(MAGIC): raise ValueError('Kernel module is unsigned')
    start=len(data)-len(MAGIC)-12
    length=int.from_bytes(data[start+8:start+12],'big')
    if length<=0 or length>start: raise ValueError('Invalid kernel signature length')
    with tempfile.TemporaryDirectory() as tmp:
        tmp=Path(tmp)
        (tmp/'body').write_bytes(data[:start-length])
        (tmp/'signature').write_bytes(data[start-length:start])
        subprocess.run(['openssl','x509','-inform','DER','-in',str(certificate),'-out',str(tmp/'cert.pem')],check=True)
        result=subprocess.run(['openssl','cms','-verify','-binary','-inform','DER','-in',str(tmp/'signature'),
                        '-content',str(tmp/'body'),'-certfile',str(tmp/'cert.pem'),'-nointern','-noverify','-out','/dev/null'],capture_output=True)
        if result.returncode:
            raise ValueError('Module signature verification failed: '+result.stderr.decode(errors='replace')[-1200:])


def reference_key_matches():
    key=KEYDIR/'key.pem'; cert=KEYDIR/'cert.der'
    if not key.is_file() or not cert.is_file(): raise ValueError('Matching kernel signing key/certificate is required')
    public_key=subprocess.check_output(['openssl','pkey','-in',str(key),'-pubout'])
    public_cert=subprocess.check_output(['openssl','x509','-inform','DER','-in',str(cert),'-pubkey','-noout'])
    if public_key!=public_cert: raise ValueError('Kernel signing key does not match its certificate')
    images=list(Path('/debs').glob('linux-image-6.6.128-vyos_*_@ARCH@.deb'))
    if len(images)!=1: raise ValueError('Exactly one native kernel image is required')
    with images[0].open('rb') as stream: image_hash=hashlib.file_digest(stream,'sha256').hexdigest()
    marker=KEYDIR/'verified'
    identity=image_hash+' '+hashlib.sha256(cert.read_bytes()).hexdigest()
    if marker.is_file() and marker.read_text()==identity: return
    with subprocess.Popen(['dpkg-deb','--fsys-tarfile',str(images[0])],stdout=subprocess.PIPE,stderr=subprocess.DEVNULL) as process:
        try:
            with tarfile.open(fileobj=process.stdout,mode='r|') as archive:
                found=False
                for member in archive:
                    if not member.isfile() or not member.name.endswith(('.ko','.ko.xz','.ko.gz','.ko.zst')): continue
                    data=archive.extractfile(member).read()
                    if member.name.endswith('.xz'): data=lzma.decompress(data)
                    elif member.name.endswith('.gz'): data=gzip.decompress(data)
                    elif member.name.endswith('.zst'): data=subprocess.check_output(['zstd','-dc'],input=data)
                    verify(data,cert)
                    found=True
                    break
                if not found: raise ValueError('No signed module in the reference kernel image')
        finally: process.stdout.close()
    marker.write_text(identity)


def main():
    parser=argparse.ArgumentParser(description=__doc__)
    parser.add_argument('directory',type=Path)
    args=parser.parse_args()
    reference_key_matches()
    tool=Path('/usr/src/linux-headers-6.6.128-vyos/scripts/sign-file')
    modules=list(args.directory.rglob('*.ko'))
    if not modules: raise ValueError('No modules found to sign')
    for module in modules:
        subprocess.run([str(tool),'sha512',str(KEYDIR/'key.pem'),str(KEYDIR/'cert.der'),str(module)],check=True)
        verify(module.read_bytes(),KEYDIR/'cert.der')
        print('Signed and verified: '+str(module),flush=True)


if __name__=='__main__': main()
