[Unit]
Description=Shirube OS per-instance local-console enrollment
After=vyos-router.service
Before=getty.target ssh.service
ConditionPathExists=/config/shirube-first-boot

[Service]
Type=oneshot
ExecStart=/usr/libexec/shirube/first-boot
StandardInput=tty-force
StandardOutput=tty
StandardError=tty
TTYPath=/dev/console
TTYReset=yes
TTYVHangup=yes
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
