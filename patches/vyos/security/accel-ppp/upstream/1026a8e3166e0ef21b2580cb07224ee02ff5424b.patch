From 1026a8e3166e0ef21b2580cb07224ee02ff5424b Mon Sep 17 00:00:00 2001
From: Ritika Chopra <r.chopra@vyos.io>
Date: Sun, 9 Aug 2026 07:16:14 +0300
Subject: [PATCH] T9238: pptp: pass a proper value to SO_REUSEADDR (port from
 accel-ppp 350)

The option value was the address of the listening descriptor rather than
a boolean, so the effect depended on the descriptor number: it enabled
SO_REUSEADDR only because that number happened to be non-zero, and would
disable it if the daemon were ever started with the lower descriptors
closed. Use a dedicated flag, as cli/telnet.c does.

Authored-by: Denys Fedoryshchenko <denys.f@collabora.com>
(cherry picked from commit 0d7cd3a4ae6beed4eab485052a5e27b0772f15c6)
---
 accel-pppd/ctrl/pptp/pptp.c | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/accel-pppd/ctrl/pptp/pptp.c b/accel-pppd/ctrl/pptp/pptp.c
index c8cf2e99..29b2e056 100644
--- a/accel-pppd/ctrl/pptp/pptp.c
+++ b/accel-pppd/ctrl/pptp/pptp.c
@@ -858,7 +858,7 @@ static void pptp_init(void)
 {
 	struct sockaddr_in addr;
 	char *opt;
-	int fd;
+	int fd, f = 1;
 
 	fd = socket(AF_PPPOX, SOCK_STREAM, PX_PROTO_PPTP);
 	if (fd >= 0)
@@ -888,7 +888,7 @@ static void pptp_init(void)
 	else
 		addr.sin_port = htons(PPTP_PORT);
 
-  setsockopt(serv.hnd.fd, SOL_SOCKET, SO_REUSEADDR, &serv.hnd.fd, 4);
+  setsockopt(serv.hnd.fd, SOL_SOCKET, SO_REUSEADDR, &f, sizeof(f));
   if (bind (serv.hnd.fd, (struct sockaddr *) &addr, sizeof (addr)) < 0) {
     log_emerg("pptp: failed to bind socket: %s\n", strerror(errno));
 		close(serv.hnd.fd);
