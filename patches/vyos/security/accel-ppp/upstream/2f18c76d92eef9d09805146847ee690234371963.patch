From 2f18c76d92eef9d09805146847ee690234371963 Mon Sep 17 00:00:00 2001
From: Ritika Chopra <r.chopra@vyos.io>
Date: Fri, 4 Sep 2026 19:22:39 -0700
Subject: [PATCH] T8550: fixup - cast sizeof(*hdr) to int to avoid warning

---
 accel-pppd/ctrl/sstp/sstp.c | 6 +++---
 1 file changed, 3 insertions(+), 3 deletions(-)

diff --git a/accel-pppd/ctrl/sstp/sstp.c b/accel-pppd/ctrl/sstp/sstp.c
index 94b9daad..2ea9b62f 100644
--- a/accel-pppd/ctrl/sstp/sstp.c
+++ b/accel-pppd/ctrl/sstp/sstp.c
@@ -1902,9 +1902,9 @@ static int sstp_handler(struct sstp_conn_t *conn, struct buffer_t *buf)
 		if (n > SSTP_MAX_PACKET_SIZE) {
 			log_ppp_error("recv [SSTP too long packet]\n");
 			return -1;
-                } else if (n < sizeof(*hdr)) {
-                        log_ppp_error("recv [SSTP too short packet]\n");
-                        return -1;
+		} else if (n < (int)sizeof(*hdr)) {
+			log_ppp_error("recv [SSTP too short packet]\n");
+			return -1;
 		} else if (n > buf->len)
 			break;
 
