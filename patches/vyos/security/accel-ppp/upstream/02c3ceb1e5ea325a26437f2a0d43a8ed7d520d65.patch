From 02c3ceb1e5ea325a26437f2a0d43a8ed7d520d65 Mon Sep 17 00:00:00 2001
From: Ritika Chopra <r.chopra@vyos.io>
Date: Tue, 22 Sep 2026 11:16:06 -0700
Subject: [PATCH] T9351: radius: support Message-Authenticator in Access
 responses

Validate the Message-Authenticator attribute in Access-Accept,
Access-Reject, and Access-Challenge packets when the attribute is present.
Reject malformed, duplicate, or invalid Message-Authenticator attributes.

Add the message-authenticator-require-access-response option to allow
operators to require Message-Authenticator in Access responses.

When enabled, Access-Accept, Access-Reject, and Access-Challenge packets
without Message-Authenticator are rejected. When disabled, compatibility
is preserved: responses without Message-Authenticator are accepted after
Response Authenticator validation, while responses that include
Message-Authenticator are still validated.
---
 accel-pppd/accel-ppp.conf    |  1 +
 accel-pppd/accel-ppp.conf.5  |  5 +++
 accel-pppd/radius/auth.c     | 84 ++++++++++++++++++++++++++++++++++++
 accel-pppd/radius/radius.c   |  4 ++
 accel-pppd/radius/radius_p.h |  4 ++
 accel-pppd/radius/req.c      |  6 +++
 6 files changed, 104 insertions(+)

diff --git a/accel-pppd/accel-ppp.conf b/accel-pppd/accel-ppp.conf
index e50f3607..73eb9419 100644
--- a/accel-pppd/accel-ppp.conf
+++ b/accel-pppd/accel-ppp.conf
@@ -229,6 +229,7 @@ verbose=1
 #attr-tunnel-type=My-Tunnel-Type
 #nas-port-id-in-req=1
 #message-authenticator-include-access-request=1
+#message-authenticator-require-access-response=1
 
 [client-ip-range]
 10.0.0.0/8
diff --git a/accel-pppd/accel-ppp.conf.5 b/accel-pppd/accel-ppp.conf.5
index c181f3f9..ff1ef470 100644
--- a/accel-pppd/accel-ppp.conf.5
+++ b/accel-pppd/accel-ppp.conf.5
@@ -1018,6 +1018,11 @@ Specifies should accel-ppp send NAS-Port-Id on Access-Request and Accounting-Req
 If this option is given and
 .B 1
 is specified then radius module will include Message-Authenticator attribute in Access-Request packets.
+.TP
+.BI "message-authenticator-require-access-response=" 0|1
+If this option is given and
+.B 1
+is specified then radius module will reject Access-Accept, Access-Reject, and Access-Challenge packets without Message-Authenticator attribute.
 .SH [log]
 .br
 Configuration of log and log_file modules.
diff --git a/accel-pppd/radius/auth.c b/accel-pppd/radius/auth.c
index a4b9704e..e1341fb9 100644
--- a/accel-pppd/radius/auth.c
+++ b/accel-pppd/radius/auth.c
@@ -1,6 +1,7 @@
 #include <stdlib.h>
 #include <string.h>
 
+#include <openssl/crypto.h>
 #include <openssl/evp.h>
 
 #include "triton.h"
@@ -14,6 +15,28 @@
 
 #include "memdebug.h"
 
+static struct rad_attr_t *find_message_authenticator(struct rad_packet_t *pack, int *duplicate)
+{
+	struct rad_attr_t *attr;
+	struct rad_attr_t *ma_attr = NULL;
+
+	*duplicate = 0;
+
+	list_for_each_entry(attr, &pack->attrs, entry) {
+		if (attr->vendor || strcmp(attr->attr->name, "Message-Authenticator"))
+			continue;
+
+		if (ma_attr) {
+			*duplicate = 1;
+			return NULL;
+		}
+
+		ma_attr = attr;
+	}
+
+	return ma_attr;
+}
+
 int verify_response_authenticator(struct rad_req_t *req, struct rad_packet_t *pack)
 {
 	uint8_t expected[16];
@@ -46,6 +69,67 @@ int verify_response_authenticator(struct rad_req_t *req, struct rad_packet_t *pa
 	return memcmp(expected, pack->buf + 4, sizeof(expected));
 }
 
+int verify_message_authenticator(struct rad_req_t *req, struct rad_packet_t *pack)
+{
+	struct rad_attr_t *ma_attr;
+	uint8_t expected[HMAC_MD5_LEN];
+	uint8_t resp_auth[HMAC_MD5_LEN];
+	uint8_t recv_ma[HMAC_MD5_LEN];
+	uint8_t *ma_ptr;
+	const uint8_t *secret;
+	int duplicate;
+	int ret;
+
+	if (!req || !pack)
+		return -1;
+
+	if (pack->code != CODE_ACCESS_ACCEPT && pack->code != CODE_ACCESS_REJECT &&
+	    pack->code != CODE_ACCESS_CHALLENGE)
+		return 0;
+
+	ma_attr = find_message_authenticator(pack, &duplicate);
+	if (duplicate)
+		return -1;
+
+	if (!ma_attr) {
+		if (conf_ma_require_access_response)
+			return -1;
+
+		/* Some RADIUS servers still omit Message-Authenticator in Access responses.
+		 * Treat absence as compatible and rely on Response Authenticator validation.
+		 */
+		return 0;
+	}
+
+	if (req->pack && req->pack->secret)
+		secret = req->pack->secret;
+	else if (req->serv && req->serv->secret)
+		secret = (const uint8_t *)req->serv->secret;
+	else
+		return -1;
+
+	if (!pack->buf || pack->len < RADIUS_HEADER_LEN || ma_attr->len != HMAC_MD5_LEN || !ma_attr->raw)
+		return -1;
+
+	ma_ptr = (uint8_t *)ma_attr->raw;
+	memcpy(resp_auth, pack->buf + RADIUS_AUTHENTICATOR_OFFSET, sizeof(resp_auth));
+	memcpy(recv_ma, ma_ptr, sizeof(recv_ma));
+
+	/* Verify Message-Authenticator over the response packet with the original
+	 * request authenticator in the header and the MA attribute value zeroed.
+	 */
+	memcpy(pack->buf + RADIUS_AUTHENTICATOR_OFFSET, req->RA, sizeof(req->RA));
+	memset(ma_ptr, 0, HMAC_MD5_LEN);
+	ret = rad_hmac_md5(secret, strlen((const char *)secret), pack->buf, pack->len, expected);
+	memcpy(ma_ptr, recv_ma, sizeof(recv_ma));
+	memcpy(pack->buf + RADIUS_AUTHENTICATOR_OFFSET, resp_auth, sizeof(resp_auth));
+
+	if (ret < 0)
+		return -1;
+
+	return CRYPTO_memcmp(expected, recv_ma, sizeof(expected));
+}
+
 static int decrypt_chap_mppe_keys(struct rad_req_t *req, struct rad_attr_t *attr, const uint8_t *challenge, uint8_t *key)
 {
 	EVP_MD_CTX *evp_ctx = EVP_MD_CTX_new();
diff --git a/accel-pppd/radius/radius.c b/accel-pppd/radius/radius.c
index 6170a630..4fdc1981 100644
--- a/accel-pppd/radius/radius.c
+++ b/accel-pppd/radius/radius.c
@@ -61,6 +61,7 @@ const char *conf_attr_tunnel_type;
 
 int conf_acct_delay_start;
 int conf_ma_include_access_request;
+int conf_ma_require_access_response;
 
 static LIST_HEAD(sessions);
 static pthread_rwlock_t sessions_lock = PTHREAD_RWLOCK_INITIALIZER;
@@ -1162,6 +1163,9 @@ static int load_config(void)
 	opt = conf_get_opt("radius", "message-authenticator-include-access-request");
 	conf_ma_include_access_request = (opt && atoi(opt) > 0) ? 1 : 0;
 
+	opt = conf_get_opt("radius", "message-authenticator-require-access-response");
+	conf_ma_require_access_response = (opt && atoi(opt) > 0) ? 1 : 0;
+
 	return 0;
 }
 
diff --git a/accel-pppd/radius/radius_p.h b/accel-pppd/radius/radius_p.h
index 756d22d7..c381451f 100644
--- a/accel-pppd/radius/radius_p.h
+++ b/accel-pppd/radius/radius_p.h
@@ -13,6 +13,8 @@
 #include "pwdb.h"
 
 #define HMAC_MD5_LEN 16
+#define RADIUS_AUTHENTICATOR_OFFSET 4
+#define RADIUS_HEADER_LEN 20
 
 struct rad_server_t;
 
@@ -203,6 +205,7 @@ extern int conf_accounting;
 extern const char *conf_attr_tunnel_type;
 extern int conf_acct_delay_start;
 extern int conf_ma_include_access_request;
+extern int conf_ma_require_access_response;
 
 int rad_check_nas_pack(struct rad_packet_t *pack);
 struct radius_pd_t *rad_find_session(const char *sessionid, const char *username, const char *port_id, int port, in_addr_t ipaddr, const char *csid);
@@ -220,6 +223,7 @@ int rad_req_send(struct rad_req_t *req);
 int __rad_req_send(struct rad_req_t *req, int async);
 int rad_req_read(struct triton_md_handler_t *h);
 int verify_response_authenticator(struct rad_req_t *req, struct rad_packet_t *pack);
+int verify_message_authenticator(struct rad_req_t *req, struct rad_packet_t *pack);
 
 struct radius_pd_t *find_pd(struct ap_session *ses);
 int rad_proc_attrs(struct rad_req_t *req);
diff --git a/accel-pppd/radius/req.c b/accel-pppd/radius/req.c
index ab941f06..1c7a771c 100644
--- a/accel-pppd/radius/req.c
+++ b/accel-pppd/radius/req.c
@@ -501,6 +501,12 @@ int rad_req_read(struct triton_md_handler_t *h)
 			continue;
 		}
 
+		if (verify_message_authenticator(req, pack)) {
+			log_ppp_warn("radius:packet: invalid message authenticator for id %u from server(%i)\n", pack->id, req->serv->id);
+			rad_packet_free(pack);
+			continue;
+		}
+
 		break;
 	}
 
