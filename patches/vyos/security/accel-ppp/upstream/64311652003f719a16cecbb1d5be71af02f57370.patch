From 64311652003f719a16cecbb1d5be71af02f57370 Mon Sep 17 00:00:00 2001
From: Ritika Chopra <r.chopra@vyos.io>
Date: Thu, 11 Jun 2026 13:14:25 +0530
Subject: [PATCH] T8545: Accel-PPP: Part 2 for Accounting workflow - adding
 code to appropriately update RA for the validation to be done later

---
 accel-pppd/radius/serv.c | 16 +++++++++++++---
 1 file changed, 13 insertions(+), 3 deletions(-)

diff --git a/accel-pppd/radius/serv.c b/accel-pppd/radius/serv.c
index d45f4217..d3f8cb20 100644
--- a/accel-pppd/radius/serv.c
+++ b/accel-pppd/radius/serv.c
@@ -365,6 +365,11 @@ static int req_set_RA(struct rad_req_t *req, const char *secret)
 	if (evp_ctx == NULL)
 		return -1;
 
+	/* RFC 2866: Accounting-Request authenticator is computed with
+	 * 16 zero bytes in the authenticator field before hashing.
+	 */
+	memset(req->RA, 0, sizeof(req->RA));
+
 	if (rad_packet_build(req->pack, req->RA)) {
 		EVP_MD_CTX_free(evp_ctx);
 		return -1;
@@ -375,6 +380,11 @@ static int req_set_RA(struct rad_req_t *req, const char *secret)
 	EVP_DigestUpdate(evp_ctx, secret, strlen(secret));
 	EVP_DigestFinal_ex(evp_ctx, req->pack->buf + 4, NULL);
 
+	/* Keep req->RA aligned with what is sent on wire so
+	 * response authenticator verification uses the right value.
+	 */
+	memcpy(req->RA, req->pack->buf + 4, sizeof(req->RA));
+
 	EVP_MD_CTX_free(evp_ctx);
 
 	return 0;
@@ -394,9 +404,9 @@ static void acct_on_recv(struct rad_req_t *req)
 
 	rad_req_free(req);
 
-	if (req->serv->starting) {
-		req->serv->starting = 0;
-		req->serv->acct_on = 1;
+	if (s->starting) {
+		s->starting = 0;
+		s->acct_on = 1;
 	} else
 		__free_server(s);
 }
