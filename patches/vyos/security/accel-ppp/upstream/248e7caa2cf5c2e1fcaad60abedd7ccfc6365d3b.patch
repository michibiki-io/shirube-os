From 248e7caa2cf5c2e1fcaad60abedd7ccfc6365d3b Mon Sep 17 00:00:00 2001
From: Ritika Chopra <r.chopra@vyos.io>
Date: Thu, 16 Apr 2026 18:33:11 -0700
Subject: [PATCH] T8526: Accel-PPP: Missing RADIUS Response Authenticator
 Verification

Added Response Authenticator verification code

As desired behavior, the authentication now fails in case wrong secret is received in Access-Accept msg from RADIUS server
---
 accel-pppd/radius/auth.c     | 32 ++++++++++++++++++++++++++++++++
 accel-pppd/radius/radius_p.h |  1 +
 accel-pppd/radius/req.c      | 14 +++++++++++---
 3 files changed, 44 insertions(+), 3 deletions(-)

diff --git a/accel-pppd/radius/auth.c b/accel-pppd/radius/auth.c
index a69f164c..f9a84f47 100644
--- a/accel-pppd/radius/auth.c
+++ b/accel-pppd/radius/auth.c
@@ -14,6 +14,38 @@
 
 #include "memdebug.h"
 
+int verify_response_authenticator(struct rad_req_t *req, struct rad_packet_t *pack)
+{
+	uint8_t expected[16];
+	EVP_MD_CTX *evp_ctx = NULL;
+	unsigned int expected_len = 0;
+
+	if (!pack || !pack->buf || !req || !req->serv || !req->serv->secret)
+		return -1;
+	if (pack->len < 20)
+		return -1;
+
+	evp_ctx = EVP_MD_CTX_new();
+	if (!evp_ctx) {
+		log_ppp_error("radius: can't create EVP context\n");
+		return -1;
+	}
+
+	/* ResponseAuth = MD5(Code+ID+Length(4) + RequestAuth(16) + Attributes + Secret) */
+	EVP_DigestInit_ex(evp_ctx, EVP_md5(), NULL);
+	EVP_DigestUpdate(evp_ctx, pack->buf, 4);
+	EVP_DigestUpdate(evp_ctx, req->RA, sizeof(req->RA));
+	EVP_DigestUpdate(evp_ctx, pack->buf + 20, pack->len - 20);
+	EVP_DigestUpdate(evp_ctx, req->serv->secret, strlen(req->serv->secret));
+	EVP_DigestFinal_ex(evp_ctx, expected, &expected_len);
+	EVP_MD_CTX_free(evp_ctx);
+
+	if (expected_len != 16)
+		return -1;
+
+	return memcmp(expected, pack->buf + 4, sizeof(expected));
+}
+
 static int decrypt_chap_mppe_keys(struct rad_req_t *req, struct rad_attr_t *attr, const uint8_t *challenge, uint8_t *key)
 {
 	EVP_MD_CTX *evp_ctx = EVP_MD_CTX_new();
diff --git a/accel-pppd/radius/radius_p.h b/accel-pppd/radius/radius_p.h
index e1e4585a..52980d62 100644
--- a/accel-pppd/radius/radius_p.h
+++ b/accel-pppd/radius/radius_p.h
@@ -215,6 +215,7 @@ void rad_req_free(struct rad_req_t *);
 int rad_req_send(struct rad_req_t *req);
 int __rad_req_send(struct rad_req_t *req, int async);
 int rad_req_read(struct triton_md_handler_t *h);
+int verify_response_authenticator(struct rad_req_t *req, struct rad_packet_t *pack);
 
 struct radius_pd_t *find_pd(struct ap_session *ses);
 int rad_proc_attrs(struct rad_req_t *req);
diff --git a/accel-pppd/radius/req.c b/accel-pppd/radius/req.c
index be74f047..894c6986 100644
--- a/accel-pppd/radius/req.c
+++ b/accel-pppd/radius/req.c
@@ -444,10 +444,18 @@ int rad_req_read(struct triton_md_handler_t *h)
 
 		rad_server_reply(req->serv);
 
-		if (pack->id == req->pack->id)
-			break;
+		if (pack->id != req->pack->id) {
+			rad_packet_free(pack);
+			continue;
+		}
+
+		if (verify_response_authenticator(req, pack)) {
+			log_ppp_warn("radius:packet: invalid response authenticator for id %u from server(%i)\n", pack->id, req->serv->id);
+			rad_packet_free(pack);
+			continue;
+		}
 
-		rad_packet_free(pack);
+		break;
 	}
 
 	req->reply = pack;
