From 2b0de7e128e78755c5568570aedcaa3d06861f72 Mon Sep 17 00:00:00 2001
From: Ritika Chopra <r.chopra@vyos.io>
Date: Tue, 23 Jun 2026 17:34:44 +0300
Subject: [PATCH] T9238: sstp: drain PPP write queue before deferring (port
 from accel-ppp 323)

Authored-by: Denys Fedoryshchenko <denys.f@collabora.com>
(cherry picked from commit af89a0a59765abb4a74b680aa7fe8c1b75488221)
---
 accel-pppd/ctrl/sstp/sstp.c | 5 +----
 1 file changed, 1 insertion(+), 4 deletions(-)

diff --git a/accel-pppd/ctrl/sstp/sstp.c b/accel-pppd/ctrl/sstp/sstp.c
index f74279e8..305a6c46 100644
--- a/accel-pppd/ctrl/sstp/sstp.c
+++ b/accel-pppd/ctrl/sstp/sstp.c
@@ -1196,7 +1196,7 @@ static int ppp_write(struct triton_md_handler_t *h)
 	ssize_t n;
 	int i;
 
-	if (!list_empty(&conn->ppp_queue)) {
+	while (!list_empty(&conn->ppp_queue)) {
 		i = n = 0;
 		list_for_each_entry(buf, &conn->ppp_queue, entry) {
 			if (i < PPP_BUF_IOVEC && n < PPP_BUF_SIZE) {
@@ -1228,9 +1228,6 @@ static int ppp_write(struct triton_md_handler_t *h)
 			list_del(&buf->entry);
 			free_buf(buf);
 		} while (n > 0);
-
-		if (!list_empty(&conn->ppp_queue))
-			goto defer;
 	}
 	triton_md_disable_handler(h, MD_MODE_WRITE);
 	return 0;
