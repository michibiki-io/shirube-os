From 762017fd16267457b25fcfb3c9ed8e7db0305ca0 Mon Sep 17 00:00:00 2001
From: Ritika Chopra <r.chopra@vyos.io>
Date: Fri, 18 Sep 2026 14:26:53 -0700
Subject: [PATCH] T9351: radius: locate Message-Authenticator attribute in the
 message before signing

The changes make the code less fragile for future by not assuming MA attribute
as the first one. If attribute ordering changes (or other code paths set
message_authenticator), this will prevent overwriting the wrong bytes and
producing an invalid packet.
---
 accel-pppd/radius/packet.c | 49 ++++++++++++++++++++++++++++++++++----
 accel-pppd/radius/req.c    |  3 +++
 2 files changed, 48 insertions(+), 4 deletions(-)

diff --git a/accel-pppd/radius/packet.c b/accel-pppd/radius/packet.c
index 3bae6277..c3f04c54 100644
--- a/accel-pppd/radius/packet.c
+++ b/accel-pppd/radius/packet.c
@@ -19,12 +19,10 @@
 #include "mempool.h"
 
 #include "radius_p.h"
+#include "attr_defs.h"
 
 #include "memdebug.h"
 
-/* RADIUS header (20) + Message-Authenticator type+length (2) */
-#define PACKET_SIGNED_OFFSET (20 + 2)
-
 static mempool_t packet_pool;
 static mempool_t attr_pool;
 static mempool_t buf_pool;
@@ -95,6 +93,42 @@ int rad_hmac_md5(const uint8_t *key, size_t key_len,
 #endif
 }
 
+static uint8_t *locate_message_authenticator_attr(struct rad_packet_t *pack)
+{
+	uint8_t *ptr;
+	uint8_t *ma_attr = NULL;
+	int len;
+
+	if (!pack || !pack->buf || pack->len < 20)
+		return NULL;
+
+	ptr = pack->buf + 20;
+	len = pack->len - 20;
+
+	while (len > 0) {
+		uint8_t attr_len;
+
+		if (len < 2)
+			return NULL;
+
+		attr_len = ptr[1];
+		if (attr_len < 2 || attr_len > len)
+			return NULL;
+
+		if (ptr[0] == Message_Authenticator) {
+			if (attr_len != HMAC_MD5_LEN + 2 || ma_attr)
+				return NULL;
+
+			ma_attr = ptr;
+		}
+
+		ptr += attr_len;
+		len -= attr_len;
+	}
+
+	return ma_attr;
+}
+
 int rad_packet_build(struct rad_packet_t *pack, uint8_t *RA)
 {
 	struct rad_attr_t *attr;
@@ -888,7 +922,14 @@ int rad_packet_send(struct rad_packet_t *pack, int fd, struct sockaddr_in *addr)
 
 	if (pack->secret && pack->message_authenticator) {
 		uint8_t hmac[HMAC_MD5_LEN];
-		uint8_t *hmac_ptr = pack->buf + PACKET_SIGNED_OFFSET;
+		uint8_t *ma_attr = locate_message_authenticator_attr(pack);
+		uint8_t *hmac_ptr;
+
+		if (!ma_attr) {
+			log_emerg("radius:packet: Message-Authenticator attribute not found\n");
+			return -1;
+		}
+		hmac_ptr = ma_attr + 2;
 
 		/* Message-Authenticator must be zeroed while calculating the HMAC (RFC 3579). */
 		memset(hmac_ptr, 0, HMAC_MD5_LEN);
diff --git a/accel-pppd/radius/req.c b/accel-pppd/radius/req.c
index 1119a6e3..c33117ed 100644
--- a/accel-pppd/radius/req.c
+++ b/accel-pppd/radius/req.c
@@ -389,6 +389,9 @@ int __rad_req_send(struct rad_req_t *req, int async)
 		rad_packet_print(req->pack, req->serv, req->log);
 	}
 
+	if (rad_packet_send(req->pack, req->hnd.fd, NULL))
+		goto out_err;
+
 	if (req->sent)
 		req->sent(req, 0);
 
