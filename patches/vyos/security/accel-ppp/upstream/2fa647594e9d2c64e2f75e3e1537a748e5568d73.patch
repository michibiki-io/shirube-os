From 2fa647594e9d2c64e2f75e3e1537a748e5568d73 Mon Sep 17 00:00:00 2001
From: Ritika Chopra <r.chopra@vyos.io>
Date: Fri, 24 Apr 2026 23:58:49 -0700
Subject: [PATCH] T8550: Accel-PPP SSTP: Zero length packet leading to infinite
 CPU loop

As a fix, a minimum-length validation check has been added to handle and return error
---
 accel-pppd/ctrl/sstp/sstp.c | 3 +++
 1 file changed, 3 insertions(+)

diff --git a/accel-pppd/ctrl/sstp/sstp.c b/accel-pppd/ctrl/sstp/sstp.c
index f74279e8..94b9daad 100644
--- a/accel-pppd/ctrl/sstp/sstp.c
+++ b/accel-pppd/ctrl/sstp/sstp.c
@@ -1902,6 +1902,9 @@ static int sstp_handler(struct sstp_conn_t *conn, struct buffer_t *buf)
 		if (n > SSTP_MAX_PACKET_SIZE) {
 			log_ppp_error("recv [SSTP too long packet]\n");
 			return -1;
+                } else if (n < sizeof(*hdr)) {
+                        log_ppp_error("recv [SSTP too short packet]\n");
+                        return -1;
 		} else if (n > buf->len)
 			break;
 
