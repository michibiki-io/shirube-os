From e610ab345cb5770d76a3b2397ff9a9158dd877c3 Mon Sep 17 00:00:00 2001
From: Ritika Chopra <r.chopra@vyos.io>
Date: Fri, 6 Feb 2026 18:04:29 +0200
Subject: [PATCH] T9238: radius: MS-CHAP2-Success unchecked memcpy(40 bytes)
 (port from accel-ppp 297)

Also fix small typo.

Authored-by: Denys Fedoryshchenko <denys.f@collabora.com>
(cherry picked from commit e3c3c7752944af85ed2854eaaf7482b018cae8b4)
---
 accel-pppd/radius/auth.c | 5 ++++-
 1 file changed, 4 insertions(+), 1 deletion(-)

diff --git a/accel-pppd/radius/auth.c b/accel-pppd/radius/auth.c
index a69f164c..f3d5b53a 100644
--- a/accel-pppd/radius/auth.c
+++ b/accel-pppd/radius/auth.c
@@ -455,7 +455,10 @@ static int rad_auth_mschap_v2_recv(struct rad_req_t *req)
 	if (req->reply->code == CODE_ACCESS_ACCEPT) {
 		ra = rad_packet_find_attr(req->reply, "Microsoft", "MS-CHAP2-Success");
 		if (!ra) {
-			log_error("radius:auth:mschap-v2: 'MS-CHAP-Success' not found in radius response\n");
+			log_error("radius:auth:mschap-v2: 'MS-CHAP2-Success' not found in radius response\n");
+			return -1;
+		} else if (ra->len < 43) {
+			log_error("radius:auth:mschap-v2: 'MS-CHAP2-Success' too short (%i)\n", ra->len);
 			return -1;
 		} else
 			memcpy(rpd->auth_ctx->authenticator, ra->val.octets + 3, 40);
