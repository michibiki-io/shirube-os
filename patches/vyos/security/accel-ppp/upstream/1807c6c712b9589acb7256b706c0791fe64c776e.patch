---
 accel-pppd/ipv6/dhcpv6.c | 12 ++++++++----
 accel-pppd/ipv6/nd.c     |  6 ++++--
 2 files changed, 12 insertions(+), 6 deletions(-)

diff --git a/accel-pppd/ipv6/dhcpv6.c b/accel-pppd/ipv6/dhcpv6.c
index 345d07ef..ff41aa45 100644
--- a/accel-pppd/ipv6/dhcpv6.c
+++ b/accel-pppd/ipv6/dhcpv6.c
@@ -960,13 +960,15 @@ static int dhcpv6_read(struct triton_md_handler_t *h)
 
 static void add_aftr_gw(const char *val)
 {
-	int n = strlen(val);
+	int n;
 	const char *ptr;
 	uint8_t *buf;
 
-	if (!val)
+	if (!val || !*val)
 		return;
 
+	n = strlen(val);
+
 	if (val[n - 1] == '.')
 		n++;
 	else
@@ -1007,13 +1009,15 @@ static void add_aftr_gw(const char *val)
 
 static void add_dnssl(const char *val)
 {
-	int n = strlen(val);
+	int n;
 	const char *ptr;
 	uint8_t *buf;
 
-	if (!val)
+	if (!val || !*val)
 		return;
 
+	n = strlen(val);
+
 	if (val[n - 1] == '.')
 		n++;
 	else
