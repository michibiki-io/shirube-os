index 43974d31..31fbd397 100644
--- a/accel-pppd/ipv6/nd.c
+++ b/accel-pppd/ipv6/nd.c
@@ -494,13 +494,15 @@ static void ev_ses_finishing(struct ap_session *ses)
 
