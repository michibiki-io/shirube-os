From dbefbdf150d85204ee3441a96aba78a9514f9f79 Mon Sep 17 00:00:00 2001
From: Ritika Chopra <r.chopra@vyos.io>
Date: Fri, 21 Aug 2026 12:26:56 -0700
Subject: [PATCH] T9351: radius: support Message-Authenticator in
 Access-Request packets

Add the message-authenticator-include-access-request option to the
RADIUS module. When enabled, Access-Request packets include a
Message-Authenticator attribute signed with HMAC-MD5, providing
integrity protection for packets sent to the RADIUS server.

Use EVP_MAC/OSSL_PARAM with OpenSSL 3.x and the HMAC() one-shot API
with older OpenSSL versions instead of the deprecated HMAC_CTX API.

Store the packet secret with packets that need Message-Authenticator
signing, and release it when the packet is freed.

Fix to update the message state as sent only when message is sent
successfully.

Sync signed MA value with MA attribute in the attributes list which
helps logging the correct MA value after signing

Inspired by upstream accel-ppp PR 244 and PR 268 (authored-by
Denys Fedoryshchenko <denys.f@collabora.com>) and manually adapted
for accel-ppp-ng conventions with additional changes as part of
the CVE-2024-3596 Blast-RADIUS mitigation.
---
 accel-pppd/accel-ppp.conf    |  1 +
 accel-pppd/accel-ppp.conf.5  |  5 +++
 accel-pppd/radius/packet.c   | 72 ++++++++++++++++++++++++++++++++++++
 accel-pppd/radius/radius.c   |  4 ++
 accel-pppd/radius/radius.h   |  2 +
 accel-pppd/radius/radius_p.h |  5 +++
 accel-pppd/radius/req.c      | 18 ++++++++-
 7 files changed, 105 insertions(+), 2 deletions(-)

diff --git a/accel-pppd/accel-ppp.conf b/accel-pppd/accel-ppp.conf
index 9a00e3c0..e50f3607 100644
--- a/accel-pppd/accel-ppp.conf
+++ b/accel-pppd/accel-ppp.conf
@@ -228,6 +228,7 @@ verbose=1
 #strip-realm=0
 #attr-tunnel-type=My-Tunnel-Type
 #nas-port-id-in-req=1
+#message-authenticator-include-access-request=1
 
 [client-ip-range]
 10.0.0.0/8
diff --git a/accel-pppd/accel-ppp.conf.5 b/accel-pppd/accel-ppp.conf.5
index 50537873..c181f3f9 100644
--- a/accel-pppd/accel-ppp.conf.5
+++ b/accel-pppd/accel-ppp.conf.5
@@ -1013,6 +1013,11 @@ Specifies should accel-ppp generate and send Acct-Session-Id on Access-Request p
 .TP
 .BI "nas-port-id-in-req=" 0|1
 Specifies should accel-ppp send NAS-Port-Id on Access-Request and Accounting-Request packets (default 1).
+.TP
+.BI "message-authenticator-include-access-request=" 0|1
+If this option is given and
+.B 1
+is specified then radius module will include Message-Authenticator attribute in Access-Request packets.
 .SH [log]
 .br
 Configuration of log and log_file modules.
diff --git a/accel-pppd/radius/packet.c b/accel-pppd/radius/packet.c
index 65213833..3bae6277 100644
--- a/accel-pppd/radius/packet.c
+++ b/accel-pppd/radius/packet.c
@@ -8,6 +8,12 @@
 #include <sys/mman.h>
 #include <linux/mman.h>
 #include <arpa/inet.h>
+#include <openssl/evp.h>
+#if OPENSSL_VERSION_NUMBER >= 0x30000000L
+#include <openssl/core_names.h>
+#else
+#include <openssl/hmac.h>
+#endif
 
 #include "log.h"
 #include "mempool.h"
@@ -16,6 +22,9 @@
 
 #include "memdebug.h"
 
+/* RADIUS header (20) + Message-Authenticator type+length (2) */
+#define PACKET_SIGNED_OFFSET (20 + 2)
+
 static mempool_t packet_pool;
 static mempool_t attr_pool;
 static mempool_t buf_pool;
@@ -47,6 +56,45 @@ void print_buf(uint8_t *buf,int size)
 	printf("\n");
 }
 
+int rad_hmac_md5(const uint8_t *key, size_t key_len,
+                 const uint8_t *data, size_t data_len,
+                 uint8_t out[HMAC_MD5_LEN])
+{
+#if OPENSSL_VERSION_NUMBER >= 0x30000000L
+	EVP_MAC *mac = EVP_MAC_fetch(NULL, "HMAC", NULL);
+	if (!mac)
+		return -1;
+
+	EVP_MAC_CTX *ctx = EVP_MAC_CTX_new(mac);
+	if (!ctx) {
+		EVP_MAC_free(mac);
+		return -1;
+	}
+
+	OSSL_PARAM params[] = {
+		OSSL_PARAM_construct_utf8_string(OSSL_MAC_PARAM_DIGEST, "MD5", 0),
+		OSSL_PARAM_construct_end()
+	};
+
+	size_t out_len = HMAC_MD5_LEN;
+	int ret = -1;
+
+	if (EVP_MAC_init(ctx, key, key_len, params) == 1 &&
+	    EVP_MAC_update(ctx, data, data_len) == 1 &&
+	    EVP_MAC_final(ctx, out, &out_len, HMAC_MD5_LEN) == 1 &&
+	    out_len == HMAC_MD5_LEN)
+		ret = 0;
+
+	EVP_MAC_CTX_free(ctx);
+	EVP_MAC_free(mac);
+	return ret;
+#else
+	unsigned int len = HMAC_MD5_LEN;
+	return (HMAC(EVP_md5(), key, (int)key_len, data, data_len, out, &len) != NULL &&
+	        len == HMAC_MD5_LEN) ? 0 : -1;
+#endif
+}
+
 int rad_packet_build(struct rad_packet_t *pack, uint8_t *RA)
 {
 	struct rad_attr_t *attr;
@@ -326,6 +374,9 @@ void rad_packet_free(struct rad_packet_t *pack)
 		mempool_free(pack->buf);
 		//munmap(pack->buf, REQ_LENGTH_MAX);
 
+	if (pack->secret)
+		_free(pack->secret);
+
 	while(!list_empty(&pack->attrs)) {
 		attr = list_entry(pack->attrs.next, typeof(*attr), entry);
 		list_del(&attr->entry);
@@ -835,6 +886,27 @@ int rad_packet_send(struct rad_packet_t *pack, int fd, struct sockaddr_in *addr)
 
 	clock_gettime(CLOCK_MONOTONIC, &pack->tv);
 
+	if (pack->secret && pack->message_authenticator) {
+		uint8_t hmac[HMAC_MD5_LEN];
+		uint8_t *hmac_ptr = pack->buf + PACKET_SIGNED_OFFSET;
+
+		/* Message-Authenticator must be zeroed while calculating the HMAC (RFC 3579). */
+		memset(hmac_ptr, 0, HMAC_MD5_LEN);
+		if (rad_hmac_md5(pack->secret, strlen((const char *)pack->secret),
+		             pack->buf, pack->len, hmac) < 0) {
+			log_emerg("radius:packet: failed to calculate HMAC\n");
+			return -1;
+		}
+		memcpy(hmac_ptr, hmac, HMAC_MD5_LEN);
+
+		/* Sync updated signed MA attribute value in the attribute list */
+		if (rad_packet_change_octets(pack, NULL, "Message-Authenticator",
+				hmac, HMAC_MD5_LEN)) {
+			log_emerg("radius:packet: failed to update Message-Authenticator attribute\n");
+			return -1;
+		}
+	}
+
 	while (1) {
 		if (addr)
 			n = sendto(fd, pack->buf, pack->len, 0, (struct sockaddr *)addr, sizeof(*addr));
diff --git a/accel-pppd/radius/radius.c b/accel-pppd/radius/radius.c
index 8aa9764d..6170a630 100644
--- a/accel-pppd/radius/radius.c
+++ b/accel-pppd/radius/radius.c
@@ -60,6 +60,7 @@ static int conf_strip_realm;
 const char *conf_attr_tunnel_type;
 
 int conf_acct_delay_start;
+int conf_ma_include_access_request;
 
 static LIST_HEAD(sessions);
 static pthread_rwlock_t sessions_lock = PTHREAD_RWLOCK_INITIALIZER;
@@ -1158,6 +1159,9 @@ static int load_config(void)
 	else
 		conf_acct_delay_start = 0;
 
+	opt = conf_get_opt("radius", "message-authenticator-include-access-request");
+	conf_ma_include_access_request = (opt && atoi(opt) > 0) ? 1 : 0;
+
 	return 0;
 }
 
diff --git a/accel-pppd/radius/radius.h b/accel-pppd/radius/radius.h
index 1925c973..617fe4b7 100644
--- a/accel-pppd/radius/radius.h
+++ b/accel-pppd/radius/radius.h
@@ -109,6 +109,8 @@ struct rad_packet_t
 	struct timespec tv;
 	struct list_head attrs;
 	uint8_t *buf;
+	int message_authenticator;
+	uint8_t *secret;
 };
 
 struct rad_plugin_t
diff --git a/accel-pppd/radius/radius_p.h b/accel-pppd/radius/radius_p.h
index c9c1e7d8..756d22d7 100644
--- a/accel-pppd/radius/radius_p.h
+++ b/accel-pppd/radius/radius_p.h
@@ -4,6 +4,7 @@
 #include <netinet/in.h>
 #include <pthread.h>
 #include <stdarg.h>
+#include <stddef.h>
 
 #include "triton.h"
 #include "radius.h"
@@ -11,6 +12,8 @@
 #include "ipdb.h"
 #include "pwdb.h"
 
+#define HMAC_MD5_LEN 16
+
 struct rad_server_t;
 
 struct radius_auth_ctx {
@@ -199,6 +202,7 @@ extern int conf_acct_interim_jitter;
 extern int conf_accounting;
 extern const char *conf_attr_tunnel_type;
 extern int conf_acct_delay_start;
+extern int conf_ma_include_access_request;
 
 int rad_check_nas_pack(struct rad_packet_t *pack);
 struct radius_pd_t *rad_find_session(const char *sessionid, const char *username, const char *port_id, int port, in_addr_t ipaddr, const char *csid);
@@ -239,6 +243,7 @@ int rad_packet_recv(int fd, struct rad_packet_t **, struct sockaddr_in *addr);
 void rad_packet_free(struct rad_packet_t *);
 void rad_packet_print(struct rad_packet_t *pack, struct rad_server_t *s, void (*print)(const char *fmt, ...));
 int rad_packet_send(struct rad_packet_t *pck, int fd, struct sockaddr_in *addr);
+int rad_hmac_md5(const uint8_t *key, size_t key_len, const uint8_t *data, size_t data_len, uint8_t out[HMAC_MD5_LEN]);
 
 void dm_coa_cancel(struct radius_pd_t *pd);
 
diff --git a/accel-pppd/radius/req.c b/accel-pppd/radius/req.c
index c72ce409..1119a6e3 100644
--- a/accel-pppd/radius/req.c
+++ b/accel-pppd/radius/req.c
@@ -73,6 +73,19 @@ static struct rad_req_t *__rad_req_alloc(struct radius_pd_t *rpd, int code, cons
 	if (!req->pack)
 		goto out_err;
 
+	if (code == CODE_ACCESS_REQUEST && conf_ma_include_access_request) {
+		uint8_t buf[HMAC_MD5_LEN] = {0};
+		req->pack->message_authenticator = 1;
+		req->pack->secret = (uint8_t *)_strdup(req->serv->secret);
+		if (!req->pack->secret)
+			goto out_err;
+		if (rad_packet_add_octets(req->pack, NULL, "Message-Authenticator", buf, HMAC_MD5_LEN)) {
+			_free(req->pack->secret);
+			req->pack->secret = NULL;
+			goto out_err;
+		}
+	}
+
 	if (code == CODE_ACCOUNTING_REQUEST && rpd->acct_username)
 		username = rpd->acct_username;
 
@@ -368,6 +381,9 @@ int __rad_req_send(struct rad_req_t *req, int async)
 	if (!req->pack->buf && rad_packet_build(req->pack, req->RA))
 		goto out_err;
 
+	if (rad_packet_send(req->pack, req->hnd.fd, NULL))
+		goto out_err;
+
 	if (req->log) {
 		req->log("send ");
 		rad_packet_print(req->pack, req->serv, req->log);
@@ -376,8 +392,6 @@ int __rad_req_send(struct rad_req_t *req, int async)
 	if (req->sent)
 		req->sent(req, 0);
 
-	rad_packet_send(req->pack, req->hnd.fd, NULL);
-
 	return 0;
 
 out_err:
