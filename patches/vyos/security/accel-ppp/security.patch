diff --git a/accel-pppd/accel-ppp.conf.5 b/accel-pppd/accel-ppp.conf.5
--- a/accel-pppd/accel-ppp.conf.5
+++ b/accel-pppd/accel-ppp.conf.5
@@ -226,7 +226,16 @@
 - calculate interface identifier from IPv4 address, for example 192:168:0:1.
 .br
 .B calling-sid
-- calculate interface identifier from Calling-Station-Id.
+- calculate an opaque interface identifier from Calling-Station-Id,
+control-plane context, and
+.BR ipv6-peer-intf-id-secret
+using HMAC-SHA256.
+.TP
+.BI "ipv6-peer-intf-id-secret=" secret
+Secret key used by
+.B ipv6-peer-intf-id=calling-sid
+to derive stable per-peer interface identifiers with HMAC-SHA256.
+The secret must be a printable non-whitespace ASCII string with length between 16 and 128 characters.
 .TP
 .BI "ipv6-accept-peer-intf-id=" 0|1
 Specify whether to accept peer's interface identifier.
@@ -571,7 +580,7 @@
 seconds.
 .TP
 .BI "echo-failure=" n
-Specifies maximum number of echo-requests may be sent without valid echo-reply, if exceeds connection will be terminated.
+Specifies maximum number of echo-requests may be sent without valid echo-reply, if exceeds connection will be terminated. Zero disables the check: echo-requests are still sent, but missing replies never terminate the connection (default 3).
 .TP
 .BI "timeout=" n
 Timeout waiting reply from client in seconds (default 5).
@@ -1004,6 +1013,16 @@
 .TP
 .BI "nas-port-id-in-req=" 0|1
 Specifies should accel-ppp send NAS-Port-Id on Access-Request and Accounting-Request packets (default 1).
+.TP
+.BI "message-authenticator-include-access-request=" 0|1
+If this option is given and
+.B 1
+is specified then radius module will include Message-Authenticator attribute in Access-Request packets.
+.TP
+.BI "message-authenticator-require-access-response=" 0|1
+If this option is given and
+.B 1
+is specified then radius module will reject Access-Accept, Access-Reject, and Access-Challenge packets without Message-Authenticator attribute.
 .SH [log]
 .br
 Configuration of log and log_file modules.
